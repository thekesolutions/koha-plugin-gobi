[% INCLUDE 'doc-head-open.inc' %]
 <title>Koha &rsaquo; Tools &rsaquo; GOBI acquisitions</title>
[% INCLUDE 'doc-head-close.inc' %]
  <style>
    .gobi {
      width: 70%;
    }
  </style>
</head>
<body>
[% INCLUDE 'header.inc' %]
[% INCLUDE 'cat-search.inc' %]

<div id="breadcrumbs">
    <a href="/cgi-bin/koha/mainpage.pl">Home</a> &rsaquo;
    <a href="/cgi-bin/koha/mainpage.pl">Tools</a> &rsaquo;
    <a href="/cgi-bin/koha/plugins/plugins-home.pl">Plugins</a> &rsaquo;
    <a href="?class=[% CLASS %]&method=[% METHOD %]">GOBI</a>
</div>

<div id="doc3" class="yui-t2">
  <div id="yui-main">
    <h2>GOBI acquisitions</h2>
    <br/>

    [% IF ( error ) %]
    <div class="dialog alert">
        <h3>ERROR</h3>
        <p>There was a problem processing your request.</p>
    </div>
    [% END %]

      <!--h4>Manually add new order</h4>
      <form method="post">
            <input type="hidden" name="class"  value="[% CLASS %]"/>
            <input type="hidden" name="method" value="[% METHOD %]"/>
            <input type="hidden" name="step"   value="add"/>
            <p>
                <label for="purchase-order-xml">Paste your new GOBI PO here: </label>
                <input type="text" name="purchase-order-xml"/>
        <input type="submit" value="Submit" /></p>
      </form>
      <br/-->

    [% IF gobi_orders.size %]
      <h4>Already processed</h4>

      <table class="table gobi">
        <thead>
          <tr>
            <th>Timestamp</th>
            <th>ID</th>
            <th>ItemPONumber</th>
            <th>Status</th>
            <th>Basket</th>
            <th>MARC link</th>
          </tr>
        </thead>
        <tbody>
      [% FOREACH gobi_order IN gobi_orders %]
          <tr>
            <td>[% gobi_order.timestamp %]</td>
            <td><a href="?class=[% CLASS %]&method=[% METHOD %]&step=get&gobi_order_id=[% gobi_order.id %]">[% gobi_order.id %]</a></td>
            <td>[% gobi_order.item_po_number %]</td>
            <td>[% gobi_order.status %]</td>
            <td>[% gobi_order.basketno %]</td>
            <td><span class="error">TODO</span></td>
          </tr>
      [% END %]
        </tbody>
      </table>
    [% END %]
  </div>
  <div class="yui-b">
    <div id="navmenu">&nbsp;</div>
  </div>
[% INCLUDE 'intranet-bottom.inc' %]
