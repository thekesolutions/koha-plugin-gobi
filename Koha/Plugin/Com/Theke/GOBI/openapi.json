{
  "/orders": {
    "post": {
      "x-mojo-to": "Com::Theke::GOBI::Controller#add_order",
      "operationId": "add_order",
      "tags": ["orders"],
      "parameters": [
        {
          "description": "API Key",
          "in": "query",
          "name": "api_key",
          "required": true,
          "type": "string"
        }
      ],
      "consumes": ["application/xml"],
      "produces": ["application/xml"],
      "responses": {
        "200": { "description": "An order id" },
        "400": { "description": "Bad request" },
        "403": { "description": "Permission denied" },
        "500": { "description": "Internal server error" }
      }
    },
    "get": {
      "x-mojo-to": "Com::Theke::GOBI::Controller#list_orders",
      "operationId": "list_gobi_orders",
      "tags": ["orders"],
      "produces": ["application/json"],
      "parameters": [
        { "name": "status", "in": "query", "type": "string", "description": "Filter by status", "required": false },
        { "name": "record_action", "in": "query", "type": "string", "description": "Filter by record action", "required": false },
        { "name": "_match", "in": "query", "type": "string", "description": "Match type", "required": false },
        { "name": "_order_by", "in": "query", "type": "string", "description": "Order by", "required": false },
        { "name": "_page", "in": "query", "type": "integer", "description": "Page number", "required": false },
        { "name": "_per_page", "in": "query", "type": "integer", "description": "Results per page", "required": false },
        { "name": "q", "in": "query", "type": "string", "description": "Query filter (JSON)", "required": false }
      ],
      "responses": {
        "200": { "description": "A list of GOBI orders" },
        "500": { "description": "Internal server error" }
      },
      "x-koha-authorization": {
        "permissions": { "acquisition": "order_manage" }
      }
    }
  },
  "/orders/filters": {
    "get": {
      "x-mojo-to": "Com::Theke::GOBI::Controller#list_order_filters",
      "operationId": "list_gobi_order_filters",
      "tags": ["orders"],
      "produces": ["application/json"],
      "responses": {
        "200": { "description": "Filter values for GOBI orders" },
        "500": { "description": "Internal server error" }
      },
      "x-koha-authorization": {
        "permissions": { "acquisition": "order_manage" }
      }
    }
  },
  "/orders/{gobi_order_id}/marc_preview": {
    "get": {
      "x-mojo-to": "Com::Theke::GOBI::Controller#marc_preview",
      "operationId": "gobi_order_marc_preview",
      "tags": ["orders"],
      "produces": ["application/json"],
      "parameters": [
        { "name": "gobi_order_id", "in": "path", "type": "integer", "required": true, "description": "GOBI order ID" }
      ],
      "responses": {
        "200": { "description": "Formatted MARC records for comparison" },
        "404": { "description": "Order not found" },
        "500": { "description": "Internal server error" }
      },
      "x-koha-authorization": {
        "permissions": { "acquisition": "order_manage" }
      }
    }
  }
}
